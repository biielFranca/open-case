@using OpenCase.Shared.Dtos

<div class="lobby-card player-card" style="--pawn-color:@(Pawn?.Color ?? "#476153")">
    <div class="player-card-heading">
        <span class="player-name">@Player.Name</span>
        @if (Player.IsHost)
        {
            <span class="host-badge" title="Host">♛ Host</span>
        }
    </div>

    <div class="player-portrait">
        <span class="player-portrait-glow"></span>
        <img src="@CharacterVisuals.ImageFor(Pawn?.Name)" alt="" />
        @if (Pawn is not null)
        {
            <span class="player-character-name">@CharacterVisuals.ShortName(Pawn.Name)</span>
        }
    </div>

    <div class="player-card-status @(Player.IsReady ? "player-ready ready-badge" : "player-waiting waiting-badge")">
        <span class="player-status-mark">@(Player.IsReady ? "✓" : "…")</span>
        <span>@(Player.IsReady ? "Pronto" : "Escolhendo personagem")</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PlayerDto Player { get; set; } = default!;
    [Parameter] public PawnDto? Pawn { get; set; }
}
