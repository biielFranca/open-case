@page "/game"
@using OpenCase.Application.Services
@using OpenCase.Shared.Dtos
@using OpenCase.Web.Services
@rendermode InteractiveServer
@inject GameClientService Client
@implements IDisposable

<PageTitle>Open Case — Partida</PageTitle>

<div class="game-page">
    @if (Client.GameState is null || Client.Board is null)
    {
        <div class="lobby-entry">
            <div class="logo">OPEN <span class="logo-accent">CASE</span></div>
            <p>Nenhuma partida ativa nesta sessão.</p>
            <a class="primary-button" href="/lobby">Voltar ao lobby</a>
        </div>
    }
    else
    {
        var state = Client.GameState;
        var isMyTurn = state.Turn.CurrentPlayerId == Client.MyPlayerId;

        <main class="game-hub">
            <section class="game-table" aria-label="Mesa da investigação">
                <div class="game-player-ring">
                    @for (var index = 0; index < Players.Count; index++)
                    {
                        var player = Players[index];
                        <GamePlayerSeat Player="player"
                                        Pawn="@PawnOf(player)"
                                        SeatNumber="@(index + 1)"
                                        IsCurrentTurn="@(state.Turn.CurrentPlayerId == player.Id)"
                                        IsMe="@(Client.MyPlayerId == player.Id)" />
                    }
                </div>

                <section class="game-board-stage">
                    <div class="game-board-aura" aria-hidden="true"></div>
                    <div class="game-board-perspective">
                        <BoardView Board="Client.Board"
                                   PawnPositions="state.PawnPositions"
                                   PawnColors="PawnColors"
                                   PawnCharacters="PawnCharacters"
                                   SelectedPath="_selectedPath"
                                   ReachableDestinations="LegalMovePaths.Keys"
                                   OnCellClick="HandleCellClick" />
                    </div>

                    @if (_selectedPath.Count > 0)
                    {
                        <div class="path-actions">
                            <span>@_selectedPath.Count / @(state.Turn.DiceValue ?? 0) passos</span>
                            <button class="primary-button" @onclick="ConfirmMoveAsync">Mover</button>
                            <button class="secondary-button" @onclick="() => _selectedPath.Clear()">Limpar</button>
                        </div>
                    }
                </section>
            </section>

            <section class="game-console">
                <aside class="game-event-console">
                    <span class="console-kicker">Central do caso</span>
                    <TurnPanel Turn="state.Turn" PlayerNames="PlayerNames" MyPlayerId="Client.MyPlayerId" />

                    <div class="game-event-feed">
                        @if (Client.LastError is not null)
                        {
                            <button class="game-event game-event-error" @onclick="Client.ClearError">
                                <strong>Atenção</strong>
                                <span>@Client.LastError</span>
                            </button>
                        }
                        else if (Client.LastPrivateCard is not null)
                        {
                            <button class="game-event" @onclick="Client.ClearPrivateCard">
                                <strong>Carta revelada</strong>
                                <span>@PlayerNames.GetValueOrDefault(Client.LastPrivateCard.ShownByPlayerId, "?") mostrou @Client.LastPrivateCard.Card.Name</span>
                            </button>
                        }
                        else if (Client.LastHint is not null)
                        {
                            <button class="game-event" @onclick="Client.ClearHint">
                                <strong>Nova pista</strong>
                                <span>@Client.LastHint.Text</span>
                            </button>
                        }
                        else
                        {
                            <div class="game-event game-event-empty">
                                <strong>Eventos da partida</strong>
                                <span>As novas pistas aparecerão aqui.</span>
                            </div>
                        }
                    </div>
                </aside>

                <section class="game-hand-console">
                    <div class="console-heading">
                        <span class="console-kicker">Arquivo pessoal</span>
                        <strong>Suas cartas</strong>
                    </div>
                    <PlayerHand Cards="MyCards" />
                </section>

                <aside class="game-action-console">
                    <span class="console-kicker">Ações</span>
                    <DicePanel DiceValue="state.Turn.DiceValue"
                               CanRoll="@(isMyTurn && state.Turn.Phase == "RollDice")"
                               OnRoll="Client.RollTurnDiceAsync" />

                    <div class="game-action-grid">
                        <button type="button" class="action-tile notes-action" @onclick="() => _showNotes = !_showNotes">
                            <span class="action-icon action-icon-notes" aria-hidden="true"></span>
                            Bloco de notas
                        </button>

                        @if (state.Turn.TurnOrder.Count == 0)
                        {
                            <button class="action-tile action-tile-primary" @onclick="Client.RollInitialDiceAsync">
                                Sortear ordem
                            </button>
                        }
                        @if (CanSuggestNow)
                        {
                            <button class="action-tile action-tile-primary" @onclick="() => _showSuggestionModal = true">
                                Dar palpite
                            </button>
                            <button class="action-tile" @onclick="Client.UseSecretPassageAsync">
                                Passagem secreta
                            </button>
                        }
                        @if (isMyTurn && state.Turn.Phase == "FinalAccusation")
                        {
                            <button class="action-tile action-tile-danger" @onclick="() => _showAccusationModal = true">
                                Acusação final
                            </button>
                        }
                    </div>
                </aside>
            </section>
        </main>

        <aside class="game-notes-drawer @(_showNotes ? "open" : "")" aria-hidden="@(!_showNotes)">
            <div class="notes-drawer-heading">
                <div>
                    <span class="console-kicker">Investigação</span>
                    <h3>Bloco de notas</h3>
                </div>
                <button type="button" class="notes-close" aria-label="Fechar bloco de notas" @onclick="() => _showNotes = false">×</button>
            </div>
            <NotesGrid Suspects="SuspectCards"
                       Locations="LocationCards"
                       Weapons="WeaponCards"
                       Marked="_notes"
                       OnToggle="ToggleNote" />
        </aside>
        @if (_showNotes)
        {
            <button type="button" class="notes-drawer-backdrop" aria-label="Fechar bloco de notas" @onclick="() => _showNotes = false"></button>
        }

        @if (_showSuggestionModal)
        {
            <SuggestionModal Suspects="SuspectCards"
                             Weapons="WeaponCards"
                             LocationName="@CurrentLocationName"
                             OnConfirm="ConfirmSuggestionAsync"
                             OnCancel="() => _showSuggestionModal = false" />
        }

        @if (NeedsMyRefutation)
        {
            <RefutationModal AvailableCards="MyRefutableCards"
                             OnShowCard="ShowRefutationCardAsync"
                             OnPass="Client.PassRefutationAsync" />
        }

        @if (_showAccusationModal && state.ActiveSuggestion is not null)
        {
            <FinalAccusationModal SuspectName="@CardName(state.ActiveSuggestion.SuspectCardId)"
                                  LocationName="@CardName(state.ActiveSuggestion.LocationCardId)"
                                  WeaponName="@CardName(state.ActiveSuggestion.WeaponCardId)"
                                  OnConfirm="ConfirmAccusationAsync"
                                  OnCancel="() => _showAccusationModal = false" />
        }

        @if (Client.LastPrivateCard is not null)
        {
            <CardRevealOverlay Card="Client.LastPrivateCard.Card"
                               ShownByName="@PlayerNames.GetValueOrDefault(Client.LastPrivateCard.ShownByPlayerId, "Alguém")"
                               OnDismiss="Client.ClearPrivateCard" />
        }
    }
</div>

@code {
    private readonly List<PositionDto> _selectedPath = [];
    private readonly Dictionary<Guid, bool> _notes = [];
    private readonly List<PawnDto> _pawns =
        [.. RoomService.AvailablePawns.Select(p => new PawnDto(p.Id, p.Name, p.Color))];
    private bool _showSuggestionModal;
    private bool _showAccusationModal;
    private bool _showNotes;

    private List<CardDto> _knownCards => Client.AllCards;
    private List<PlayerDto> Players => Client.Room?.Players ?? [];

    protected override void OnInitialized()
    {
        Client.OnChange += HandleChange;
    }

    private void HandleChange() => _ = InvokeAsync(StateHasChanged);

    private Dictionary<Guid, string> PlayerNames =>
        Client.Room?.Players.ToDictionary(p => p.Id, p => p.Name) ?? [];

    private Dictionary<Guid, string> PawnColors =>
        Players.Where(p => p.PawnId is not null)
            .ToDictionary(p => p.Id, p => PawnOf(p)?.Color ?? "#888");

    private Dictionary<Guid, PawnDto> PawnCharacters =>
        Players.Where(player => player.PawnId is not null)
            .Select(player => (Player: player, Pawn: PawnOf(player)))
            .Where(item => item.Pawn is not null)
            .ToDictionary(item => item.Player.Id, item => item.Pawn!);

    private PawnDto? PawnOf(PlayerDto? player) =>
        player?.PawnId is null ? null : _pawns.FirstOrDefault(p => p.Id == player.PawnId);

    private List<CardDto> MyCards => Client.Hand?.Cards ?? [];

    private List<CardDto> CardsOf(string type) => [.. _knownCards.Where(c => c.Type == type)];

    private List<CardDto> SuspectCards => CardsOf("Suspect");
    private List<CardDto> LocationCards => CardsOf("Location");
    private List<CardDto> WeaponCards => CardsOf("Weapon");

    private IReadOnlyDictionary<PositionDto, List<PositionDto>> LegalMovePaths
    {
        get
        {
            var state = Client.GameState;
            if (Client.Board is null
                || state?.Turn.CurrentPlayerId != Client.MyPlayerId
                || state.Turn.Phase != "Move"
                || state.Turn.DiceValue is not int diceValue
                || !state.PawnPositions.TryGetValue(Client.MyPlayerId, out var start))
            {
                return new Dictionary<PositionDto, List<PositionDto>>();
            }

            return BoardMovementPaths.FindLegalPaths(Client.Board, start, diceValue);
        }
    }

    private string CurrentLocationName
    {
        get
        {
            var position = Client.GameState?.PawnPositions.GetValueOrDefault(Client.MyPlayerId);
            if (position is null || Client.Board is null)
            {
                return "?";
            }

            var cell = Client.Board.Cells.FirstOrDefault(c => c.X == position.X && c.Y == position.Y);
            return Client.Board.Locations.FirstOrDefault(l => l.Id == cell?.LocationId)?.Name ?? "?";
        }
    }

    // O jogador pode palpitar sempre que for a vez dele e o peão estiver dentro de
    // uma sala — inclusive quando começa o turno já em um cômodo (o tabuleiro novo
    // posiciona os peões dentro das salas). O hub valida o local de fato.
    private bool CanSuggestNow =>
        Client.GameState is { } state
        && state.Turn.CurrentPlayerId == Client.MyPlayerId
        && state.Turn.Phase is "RollDice" or "Move" or "Suggestion"
        && CurrentLocationName != "?";

    private bool NeedsMyRefutation =>
        Client.GameState?.ActiveRefutation is { IsResolved: false } refutation
        && refutation.CurrentRefutingPlayerId == Client.MyPlayerId;

    private List<CardDto> MyRefutableCards
    {
        get
        {
            var suggestion = Client.GameState?.ActiveSuggestion;
            if (suggestion is null)
            {
                return [];
            }

            Guid[] cited = [suggestion.SuspectCardId, suggestion.LocationCardId, suggestion.WeaponCardId];
            return [.. MyCards.Where(c => cited.Contains(c.Id))];
        }
    }

    private string CardName(Guid cardId) =>
        _knownCards.FirstOrDefault(c => c.Id == cardId)?.Name ?? "?";

    private void HandleCellClick(PositionDto position)
    {
        if (!LegalMovePaths.TryGetValue(position, out var path))
        {
            return;
        }

        _selectedPath.Clear();
        _selectedPath.AddRange(path);
    }

    private async Task ConfirmMoveAsync()
    {
        await Client.MovePawnAsync([.. _selectedPath]);
        _selectedPath.Clear();
    }

    private async Task ConfirmSuggestionAsync((Guid SuspectId, Guid WeaponId) pick)
    {
        _showSuggestionModal = false;
        await Client.MakeSuggestionAsync(pick.SuspectId, pick.WeaponId);
    }

    private async Task ShowRefutationCardAsync(Guid cardId) =>
        await Client.ShowRefutationCardAsync(cardId);

    private async Task ConfirmAccusationAsync()
    {
        _showAccusationModal = false;
        await Client.MakeFinalAccusationAsync();
    }

    private void ToggleNote(Guid cardId) =>
        _notes[cardId] = !_notes.GetValueOrDefault(cardId);

    public void Dispose()
    {
        Client.OnChange -= HandleChange;
    }
}
