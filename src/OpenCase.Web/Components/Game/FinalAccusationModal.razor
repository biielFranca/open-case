@using OpenCase.Shared.Dtos

<div class="modal-backdrop">
    <div class="modal accusation-modal">
        <h3>Acusação final</h3>
        <p>Ninguém refutou seu palpite. Você pode encerrar o caso com esta acusação:</p>
        <div class="accusation-summary">
            @if (SuspectCard is not null)
            {
                @RenderSummaryCard(SuspectCard)
            }
            @if (LocationCard is not null)
            {
                @RenderSummaryCard(LocationCard)
            }
            @if (WeaponCard is not null)
            {
                @RenderSummaryCard(WeaponCard)
            }
        </div>
        <p class="panel-hint">Se errar, você perde o próximo turno e a solução continua secreta.</p>
        <div class="modal-actions">
            <button type="button" class="secondary-button" @onclick="() => OnCancel.InvokeAsync()">Ainda não</button>
            <button type="button" class="confirm-button primary-button" @onclick="() => OnConfirm.InvokeAsync()">Acusar!</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public CardDto? SuspectCard { get; set; }
    [Parameter] public CardDto? LocationCard { get; set; }
    [Parameter] public CardDto? WeaponCard { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private static RenderFragment RenderSummaryCard(CardDto card) => __builder =>
    {
        <article class="modal-card modal-card-readonly accusation-card card-@card.Type.ToLowerInvariant()">
            <span class="modal-card-art" aria-hidden="true">
                <img src="@CardVisuals.ImageFor(card)" alt="" />
            </span>
            <span class="modal-card-shade" aria-hidden="true"></span>
            <span class="modal-card-type">@CardVisuals.TypeLabel(card.Type)</span>
            <span class="modal-card-name">@card.Name</span>
        </article>
    };
}
