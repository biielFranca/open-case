@using OpenCase.Shared.Dtos

<div class="board-view" style="--board-cols:@(Board?.Width ?? 30);--board-rows:@(Board?.Height ?? 30)">
    @if (Board is not null)
    {
        @foreach (var location in Board.Locations)
        {
            var reachableEntrance = _reachableLocations.GetValueOrDefault(location.Id);
            var isReachable = reachableEntrance is not null;
            var isSelected = SelectedPath.Any(position => LocationIdAt(position) == location.Id);
            var roomPawns = PawnsInLocation(location.Id).ToList();
            <div class="board-room-layer @(location.HasSecretPassage ? "has-secret-passage" : "") @(isReachable ? "reachable clickable" : "") @(isSelected ? "selected" : "")"
                 data-location-id="@location.Id"
                 style="@GetRoomStyle(location)"
                 title="@location.Name"
                 @onclick="() => HandleRoomClick(reachableEntrance)">
                <span class="board-room-name">@location.Name</span>
                @for (var pawnIndex = 0; pawnIndex < roomPawns.Count; pawnIndex++)
                {
                    var pawn = roomPawns[pawnIndex];
                    <span class="board-character character-3d board-room-character @GetPawnModelVariant(pawn.Key)"
                          style="@GetRoomPawnStyle(pawn.Key, pawnIndex)"
                          title="@GetPawnName(pawn.Key)"
                          aria-label="@GetPawnName(pawn.Key)">
                        <span class="character-shadow"></span>
                        <span class="character-figure">
                            <span class="character-portrait"></span>
                            <span class="character-frame"></span>
                        </span>
                        <span class="character-base"></span>
                    </span>
                }
                @if (location.HasSecretPassage)
                {
                    <span class="board-room-passage" aria-hidden="true"></span>
                }
            </div>
        }

        @for (var y = 0; y < Board.Height; y++)
        {
            var row = y;
            @for (var x = 0; x < Board.Width; x++)
            {
                var col = x;
                var cell = _cellLookup[(col, row)];
                var isSelected = cell.LocationId is null && SelectedPath.Any(p => p.X == col && p.Y == row);
                var isReachable = _reachableLookup.Contains((col, row)) && cell.LocationId is null;
                <div class="board-cell cell-@cell.Type.ToLowerInvariant() @GetCellVisualClass(cell) @(isSelected ? "selected" : "") @(isReachable ? "reachable clickable" : "")"
                     data-cell="@($"{col}-{row}")"
                     style="@($"grid-column:{col + 1};grid-row:{row + 1}")"
                     title="@GetCellTitle(cell)"
                     @onclick="() => HandleClick(cell, isReachable)">
                    @foreach (var pawn in PawnPositions.Where(p =>
                        p.Value.X == col && p.Value.Y == row && LocationIdAt(p.Value) is null))
                    {
                        <span class="board-character character-3d @GetPawnModelVariant(pawn.Key)"
                              style="@GetPawnColorStyle(pawn.Key)"
                              title="@GetPawnName(pawn.Key)"
                              aria-label="@GetPawnName(pawn.Key)">
                            <span class="character-shadow"></span>
                            <span class="character-figure">
                                <span class="character-portrait"></span>
                                <span class="character-frame"></span>
                            </span>
                            <span class="character-base"></span>
                        </span>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public BoardDto? Board { get; set; }
    [Parameter] public Dictionary<Guid, PositionDto> PawnPositions { get; set; } = [];
    [Parameter] public Dictionary<Guid, string> PawnColors { get; set; } = [];
    [Parameter] public Dictionary<Guid, PawnDto> PawnCharacters { get; set; } = [];
    [Parameter] public List<PositionDto> SelectedPath { get; set; } = [];
    [Parameter] public IEnumerable<PositionDto> ReachableDestinations { get; set; } = [];
    [Parameter] public EventCallback<PositionDto> OnCellClick { get; set; }

    private Dictionary<(int X, int Y), BoardCellDto> _cellLookup = [];
    private HashSet<(int X, int Y)> _reachableLookup = [];
    private Dictionary<Guid, PositionDto> _reachableLocations = [];
    private Dictionary<Guid, LocationBounds> _locationBounds = [];
    private Dictionary<Guid, string> _locationNames = [];

    private static readonly Dictionary<string, string> LocationAssets = new()
    {
        ["Biblioteca"] = "biblioteca",
        ["Salão de Festas"] = "salao-de-festas",
        ["Cozinha"] = "cozinha",
        ["Escritório"] = "escritorio",
        ["Jardim de Inverno"] = "jardim-de-inverno",
        ["Sala de Jantar"] = "sala-de-jantar",
        ["Salão de Jogos"] = "salao-de-jogos",
        ["Hall"] = "hall",
        ["Estufa"] = "estufa",
        ["Porão"] = "porao",
        ["Observatório"] = "observatorio",
        ["Quarto de Hóspedes"] = "quarto-de-hospedes",
    };

    private static readonly Dictionary<Guid, string> PawnVariants = new()
    {
        [Guid.Parse("00000000-0000-0000-0000-000000000001")] = "pawn-arthur",
        [Guid.Parse("00000000-0000-0000-0000-000000000002")] = "pawn-helena",
        [Guid.Parse("00000000-0000-0000-0000-000000000003")] = "pawn-otavio",
        [Guid.Parse("00000000-0000-0000-0000-000000000004")] = "pawn-cecilia",
        [Guid.Parse("00000000-0000-0000-0000-000000000005")] = "pawn-raul",
        [Guid.Parse("00000000-0000-0000-0000-000000000006")] = "pawn-amelia",
        [Guid.Parse("00000000-0000-0000-0000-000000000007")] = "pawn-clara",
        [Guid.Parse("00000000-0000-0000-0000-000000000008")] = "pawn-afonso",
        [Guid.Parse("00000000-0000-0000-0000-000000000009")] = "pawn-sebastiao",
        [Guid.Parse("00000000-0000-0000-0000-000000000010")] = "pawn-iris",
        [Guid.Parse("00000000-0000-0000-0000-000000000011")] = "pawn-vicente",
        [Guid.Parse("00000000-0000-0000-0000-000000000012")] = "pawn-elisa",
    };

    protected override void OnParametersSet()
    {
        _reachableLookup = ReachableDestinations.Select(position => (position.X, position.Y)).ToHashSet();

        if (Board is not { } board)
        {
            _cellLookup = [];
            _locationNames = [];
            _locationBounds = [];
            return;
        }

        _cellLookup = board.Cells.ToDictionary(c => (c.X, c.Y));
        _locationNames = board.Locations.ToDictionary(l => l.Id, l => l.Name);
        _reachableLocations = ReachableDestinations
            .Select(position => (Position: position, LocationId: LocationIdAt(position)))
            .Where(item => item.LocationId is not null)
            .GroupBy(item => item.LocationId!.Value)
            .ToDictionary(group => group.Key, group => group.First().Position);
        _locationBounds = board.Locations.ToDictionary(
            location => location.Id,
            location =>
            {
                var cells = board.Cells.Where(cell => cell.LocationId == location.Id).ToList();
                var minX = cells.Min(cell => cell.X);
                var minY = cells.Min(cell => cell.Y);
                return new LocationBounds(
                    minX,
                    minY,
                    cells.Max(cell => cell.X) - minX + 1,
                    cells.Max(cell => cell.Y) - minY + 1);
            });
    }

    private string GetRoomStyle(BoardLocationDto location)
    {
        var bounds = _locationBounds[location.Id];
        var asset = LocationAssets[location.Name];
        return $"grid-column:{bounds.X + 1}/span {bounds.Width};grid-row:{bounds.Y + 1}/span {bounds.Height};--room-image:url('/images/board/locations/{asset}.jpg')";
    }

    private string GetCellTitle(BoardCellDto cell) =>
        cell.Type == "SecretPassage"
            ? $"Passagem secreta em {_locationNames.GetValueOrDefault(cell.LocationId ?? Guid.Empty, "local desconhecido")}"
            : cell.LocationId is Guid locationId
                ? _locationNames.GetValueOrDefault(locationId, string.Empty)
                : string.Empty;

    private string GetCellVisualClass(BoardCellDto cell)
    {
        if (cell.Type == "Entrance")
        {
            return GetDoorClass(cell.X, cell.Y);
        }

        if (cell.Type != "Path")
        {
            return string.Empty;
        }

        if (cell.Y >= 28 || cell.X is 7 or 8 or 17 or 18 or 24)
        {
            return "floor-marble";
        }

        if (cell.Y is 8 or 9 or 18 or 19 or 20)
        {
            return "floor-runner";
        }

        return "floor-wood";
    }

    private string GetDoorClass(int x, int y)
    {
        if (IsPath(x, y - 1)) return "door-top";
        if (IsPath(x, y + 1)) return "door-bottom";
        if (IsPath(x - 1, y)) return "door-left";
        if (IsPath(x + 1, y)) return "door-right";
        return string.Empty;
    }

    private bool IsPath(int x, int y) =>
        _cellLookup.TryGetValue((x, y), out var cell) && cell.Type == "Path";

    private Guid? LocationIdAt(PositionDto position) =>
        _cellLookup.GetValueOrDefault((position.X, position.Y))?.LocationId;

    private IEnumerable<KeyValuePair<Guid, PositionDto>> PawnsInLocation(Guid locationId) =>
        PawnPositions.Where(pawn => LocationIdAt(pawn.Value) == locationId);

    private string GetRoomPawnStyle(Guid playerId, int index)
    {
        var positions = new (int Left, int Top)[]
        {
            (18, 20), (42, 18), (66, 20), (28, 48), (54, 48), (40, 68), (70, 62), (14, 64),
        };
        var position = positions[index % positions.Length];
        return $"left:{position.Left}%;top:{position.Top}%;{GetPawnColorStyle(playerId)}";
    }

    private string GetPawnColorStyle(Guid playerId) =>
        $"--pawn-color:{PawnColors.GetValueOrDefault(playerId, "#888")};--pawn-accent:{GetPawnAccent(playerId)};--character-image:url('{GetCharacterImage(playerId)}')";

    private string GetCharacterImage(Guid playerId) =>
        GetPawnModelVariant(playerId) switch
        {
            "pawn-arthur" => "/images/characters/arthur-vale.jpg",
            "pawn-helena" => "/images/characters/helena-vesper.jpg",
            "pawn-otavio" => "/images/characters/otavio-lacerda.jpg",
            "pawn-cecilia" => "/images/characters/cecilia-marinho.jpg",
            "pawn-raul" => "/images/characters/raul-ferraz.jpg",
            "pawn-amelia" => "/images/characters/amelia-bellini.jpg",
            "pawn-clara" => "/images/characters/clara-vidal.jpg",
            "pawn-afonso" => "/images/characters/afonso-brandao.jpg",
            "pawn-sebastiao" => "/images/characters/sebastiao-leme.jpg",
            "pawn-iris" => "/images/characters/iris-montenegro.jpg",
            "pawn-vicente" => "/images/characters/vicente-dourado.jpg",
            "pawn-elisa" => "/images/characters/elisa-campos.jpg",
            _ => "/images/login-detective.jpg",
        };

    private string GetPawnAccent(Guid playerId) =>
        GetPawnModelVariant(playerId) switch
        {
            "pawn-arthur" => "#b9e2dd",
            "pawn-helena" => "#e6b3c2",
            "pawn-otavio" => "#d8c7f3",
            "pawn-cecilia" => "#e7f3a6",
            "pawn-raul" => "#b8d2e8",
            "pawn-amelia" => "#f0b7d6",
            "pawn-clara" => "#f4c18e",
            "pawn-afonso" => "#fff0c7",
            "pawn-sebastiao" => "#d0b69d",
            "pawn-iris" => "#a9c1ff",
            "pawn-vicente" => "#b6d7aa",
            "pawn-elisa" => "#efbd94",
            _ => "#e5e5e5",
        };

    private string GetPawnName(Guid playerId) =>
        PawnCharacters.GetValueOrDefault(playerId)?.Name ?? "Personagem";

    private string GetPawnModelVariant(Guid playerId) =>
        PawnCharacters.TryGetValue(playerId, out var pawn)
            ? PawnVariants.GetValueOrDefault(pawn.Id, "pawn-generic")
            : "pawn-generic";

    private Task HandleRoomClick(PositionDto? reachableEntrance) =>
        reachableEntrance is null ? Task.CompletedTask : OnCellClick.InvokeAsync(reachableEntrance);

    private Task HandleClick(BoardCellDto cell, bool isReachable) =>
        isReachable ? OnCellClick.InvokeAsync(new PositionDto(cell.X, cell.Y)) : Task.CompletedTask;

    private sealed record LocationBounds(int X, int Y, int Width, int Height);
}
